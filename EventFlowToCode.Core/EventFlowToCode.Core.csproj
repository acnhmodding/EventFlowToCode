<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AcnhModding.EventFlowToCode.Core</PackageId>
    <Version>1.0.0</Version>
    <Authors>ACNH Modding</Authors>
    <Description>Compiler and decompiler for readable Nintendo EventFlow (.bfevfl) source.</Description>
    <PackageProjectUrl>https://github.com/acnhmodding/EventFlowToCode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/acnhmodding/EventFlowToCode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bfevfl;evfl;eventflow;compiler;decompiler;nintendo;acnh</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <UseLocalBfevLibrary Condition="'$(UseLocalBfevLibrary)' == ''">false</UseLocalBfevLibrary>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EventFlowToCode.Tests" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalBfevLibrary)' != 'true'">
    <PackageReference Include="AcnhModding.BfevLibrary" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalBfevLibrary)' == 'true'">
    <ProjectReference Include="../BfevLibrary/src/BfevLibrary.csproj" />
  </ItemGroup>

</Project>